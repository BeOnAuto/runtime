{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "env": ["CI"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.turbo/services/postgresql.json",
        "$TURBO_ROOT$/.turbo/services/object-store.json"
      ],
      "passThroughEnv": ["LEDGER_TEST_POSTGRESQL_URL", "CONTENT_TEST_OBJECT_STORE_URL"]
    }
  }
}
