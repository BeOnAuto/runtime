{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["**/node_modules/**", "**/coverage/**", "**/dist/**"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": false,
        "allowNumber": false,
        "allowNullableObject": false
      }
    ],
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowAny": false,
        "allowBoolean": false,
        "allowNullish": false,
        "allowNumber": true,
        "allowRegExp": false,
        "allowNever": false
      }
    ],
    "typescript/unbound-method": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/only-throw-error": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/ban-ts-comment": "error",
    "eslint/no-warning-comments": [
      "error",
      {
        "terms": ["v8 ignore", "istanbul ignore", "c8 ignore", "oxlint-disable", "eslint-disable"],
        "location": "anywhere"
      }
    ],
    "eslint/complexity": [
      "error",
      {
        "max": 10
      }
    ],
    "eslint/max-depth": ["error", 3],
    "eslint/max-params": ["error", 4],
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:worker_threads",
            "message": "Worker threads belong to the program pool of @on.auto/workflow-engine; a worker module serves its jobs with @on.auto/workflow-engine/job-loop."
          }
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "package",
            "package": "node:http",
            "name": ["Server", "IncomingMessage", "ServerResponse"]
          },
          {
            "from": "package",
            "package": "effect",
            "name": ["Effect", "Layer"]
          },
          {
            "from": "package",
            "package": "hono",
            "name": ["Context"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/workflow-engine/src/program-pool/**", "capabilities/computation/measure/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "packages/server/src/composition/composition-root.test.ts",
        "packages/server/src/composition/content-store.test.ts",
        "packages/server/src/composition/served-access-control.test.ts",
        "packages/server/src/computation/computation-over-http.test.ts",
        "packages/server/src/connections/connections-over-http.test.ts",
        "packages/server/src/consent/consent-over-http.test.ts",
        "packages/server/src/database/database-pools.test.ts",
        "packages/server/src/database/ledger-of-content-not-found.test.ts",
        "packages/server/src/database/ledger-stores.test.ts",
        "packages/server/src/generation/generation-over-http.test.ts",
        "packages/server/src/goals/notices/goal-notices.test.ts",
        "packages/server/src/goals/reads/goals-read.test.ts",
        "packages/server/src/interaction/interaction-over-http.test.ts",
        "packages/server/src/interaction/interaction-through-tools.test.ts",
        "packages/server/src/lifecycle/ledger-startup.test.ts",
        "packages/server/src/lifecycle/lifecycle.test.ts",
        "packages/server/src/lifecycle/shutdown.test.ts",
        "packages/server/src/logging/logging.test.ts",
        "packages/server/src/lookup/calls.test.ts",
        "packages/server/src/mcp/mcp-endpoint.test.ts",
        "packages/server/src/mcp/plain-results.test.ts",
        "packages/server/src/mcp/served-schemas.test.ts",
        "packages/server/src/mcp/served-tools.test.ts",
        "packages/server/src/metering/counted-runs.test.ts",
        "packages/server/src/playbooks/changes-over-http.test.ts",
        "packages/server/src/prediction/prediction-by-an-extension.test.ts",
        "packages/server/src/prediction/prediction-over-http.test.ts",
        "packages/server/src/reading/runs-and-events-over-http.test.ts",
        "packages/server/src/reasoning/definitions-over-http.test.ts",
        "packages/server/src/reasoning/listed-models.test.ts",
        "packages/server/src/reasoning/prompts-and-answers-on-stores.test.ts",
        "packages/server/src/reasoning/reasoning-failures-over-http.test.ts",
        "packages/server/src/reasoning/reasoning-over-http.test.ts",
        "packages/server/src/reasoning/tools-over-http.test.ts",
        "packages/server/src/studio/studio-over-http.test.ts",
        "packages/server/src/tool-servers/hand-calls-over-http.test.ts",
        "packages/server/src/tool-servers/tool-reads-over-http.test.ts",
        "packages/server/src/usage-ping/usage-ping-in-the-server.test.ts",
        "packages/server/src/workflow-calls/kept-documents-called.test.ts",
        "packages/server/src/workflow-runs/workflow-tools.test.ts",
        "packages/server/src/workflow-runs/workflows-over-http.test.ts",
        "packages/server/src/workflow-runs/workflows-over-mcp.test.ts",
        "packages/server/src/workflows/host-dependencies.test.ts",
        "packages/server/src/workflows/workflow-lifecycle.test.ts",
        "packages/workflow-engine/src/cache/cached-inputs.test.ts",
        "packages/workflow-engine/src/cache/run-cache.test.ts",
        "packages/workflow-engine/src/decider/open-calls.test.ts",
        "packages/workflow-engine/src/decider/run-lifecycle.test.ts",
        "packages/workflow-engine/src/decider/written-formats.test.ts",
