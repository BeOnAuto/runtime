        "packages/workflow-engine/src/program-pool/warm-workers.test.ts",
        "packages/workflow-engine/src/run-log/formats/format-one.test.ts",
        "packages/workflow-engine/src/run-log/formats/format-six-records.test.ts",
        "packages/workflow-host/src/due-work/due-work.test.ts",
        "packages/workflow-host/src/emissions/host-emissions.test.ts",
        "packages/workflow-host/src/follower/delivery-loop.test.ts",
        "packages/workflow-host/src/follower/followed-events.test.ts",
        "packages/workflow-host/src/follower/kept-output-steps.test.ts",
        "packages/workflow-host/src/follower/pass-wants.test.ts",
        "packages/workflow-host/src/host/host-answers.test.ts",
        "packages/workflow-host/src/listeners/sql-listeners.test.ts",
        "packages/workflow-host/src/loop/host-loop.test.ts",
        "packages/workflow-host/src/reactions/host-reactions.test.ts",
        "packages/workflow-host/src/runs/ledger-run-store.test.ts",
        "packages/workflow-host/src/runs/run-lineage.test.ts",
        "packages/workflow-host/src/runs/run-payloads.test.ts",
        "packages/workflow-host/src/settlement/settle-back-off.test.ts",
        "packages/workflow-host/src/sweeps/playbook-sweeps.test.ts",
        "packages/workflow-host/src/triggers/trigger-versions.test.ts",
        "packages/workflow-host/src/views/page-bounds.test.ts",
        "packages/workflow-host/src/waiting/cancel-requests.test.ts",
        "packages/workflow-host/src/waiting/child-endings.test.ts"
      ],
      "rules": {
        "eslint/max-lines": "off",
        "eslint/max-lines-per-function": "off",
        "import/max-dependencies": "off"
      }
    }
  ]
}
