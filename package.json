{
  "name": "@on.auto/runtime",
  "version": "0.39.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @on.auto/server dev",
    "key": "pnpm --filter @on.auto/identity key",
    "docs:dev": "cd docs && vitepress dev",
    "docs:build": "cd docs && vitepress build",
    "docs:preview": "cd docs && vitepress preview",
    "docs:taxonomy": "node scripts/docs-function-taxonomy.ts",
    "docs:taxonomy:check": "node scripts/docs-function-taxonomy.ts --check",
    "docs:openapi": "node scripts/openapi-document.ts",
    "docs:test": "node --test scripts/*.test.ts",
    "docs:lint": "oxlint -c .oxlintrc.json scripts/*.ts && tsc --project scripts/tsconfig.json",
    "docs:check": "pnpm docs:lint && pnpm docs:taxonomy:check && pnpm docs:build && pnpm docs:test",
    "test:watch": "vitest",
    "typecheck:watch": "tsc --watch",
    "check": "pnpm check:tasks && pnpm docs:check",
    "check:tasks": "turbo run format:check lint typecheck test knip sherif",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint *.ts",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "sherif": "sherif",
    "commit": "czg",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "czg": "1.14.0",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "sherif": "1.13.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitepress": "1.6.4",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
