{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "sortImports": {},
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "packages/api/src/testing/openapi/openapi-3.1-schema-2022-10-07.json",
    "docs/assets/openapi.json",
    "**/src/**/[0-9]*.[0-9]*.[0-9]*/*.json"
  ],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
