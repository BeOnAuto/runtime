{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalPassThroughEnv": ["TMPDIR", "VITEST_MAX_WORKERS", "CI", "CI_TASK_POOL_SOCKET", "PNPM_CONFIG_SCRIPT_SHELL"],
  "globalDependencies": [
    "package.json",
    "tsconfig.base.json",
    ".oxlintrc.json",
    "vitest.shared.ts",
    "packages/operations/src/process-testing/test-run-folder.ts",
    "packages/operations/src/process-testing/process-endings.ts",
    ".nvmrc",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.turbo/platform.json"],
      "env": ["CI"],
      "outputs": ["coverage/**"]
    },
    "test:shard": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.turbo/platform.json"],
      "env": ["CI", "VITEST_SHARD", "LEDGER_TEST_POSTGRESQL_URL", "CONTENT_TEST_OBJECT_STORE_URL"],
      "outputs": [".vitest/blob/**"]
    },
    "//#format:check": {
      "cache": false
    },
    "//#knip": {
      "cache": false
    },
    "//#sherif": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "ci": {
      "dependsOn": ["lint", "typecheck", "test"]
    },
    "//#ci": {
      "dependsOn": ["format:check", "lint", "knip", "sherif", "docs:check"]
    },
    "//#docs:check": {
      "cache": false
    }
  }
}
