{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalPassThroughEnv": ["TMPDIR"],
  "globalDependencies": [
    "package.json",
    "tsconfig.base.json",
    ".oxlintrc.json",
    "vitest.shared.ts",
    ".nvmrc",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "!$TURBO_ROOT$/docs/.vitepress/cache/**",
        "!$TURBO_ROOT$/docs/.vitepress/dist/**"
      ],
      "env": ["LEDGER_TEST_POSTGRESQL_URL", "CONTENT_TEST_OBJECT_STORE_URL", "SECRETS_TEST_AWS_URL"],
      "outputs": ["coverage/**"]
    },
    "test:shard": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "!$TURBO_ROOT$/docs/.vitepress/cache/**",
        "!$TURBO_ROOT$/docs/.vitepress/dist/**"
      ],
      "env": ["VITEST_SHARD", "LEDGER_TEST_POSTGRESQL_URL", "CONTENT_TEST_OBJECT_STORE_URL"],
      "outputs": [".vitest/blob/**"]
    },
    "//#format:check": {
      "cache": false
    },
    "//#knip": {
      "cache": false
    },
    "//#sherif": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    }
  }
}
