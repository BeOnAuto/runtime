# Your own settings for pnpm dev. Copy this file to .env,
# which git ignores, uncomment what you use and put your keys in.
# They are read after packages/server/dev.env, and a variable set in the shell
# wins over both files. The server in a container never reads .env.
# Settings that are lists or maps, such as model gateways and aliases, go in
# auto-runtime.yaml; copy auto-runtime.example.yaml to start it.

# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-key

# pnpm dev runs in local mode: every request on this machine acts as you, with no sign-in.
# PUBLIC_URL signs people in through the Auto identity service instead.
# PUBLIC_URL=http://localhost:5555

# The key of the gateway in auto-runtime.example.yaml, which refers to it as ${GATEWAY_API_KEY}.
# GATEWAY_API_KEY=your-gateway-key

# Keep the ledger in PostgreSQL instead of packages/server/.data. Empty LEDGER_FILE
# too, since dev.env names a ledger file and the server refuses both. A ledger in
# PostgreSQL needs SECRETS_KEY, the key its secrets are sealed under: put in its
# place the line openssl rand -base64 32 prints, or name a file that holds it in
# SECRETS_KEY_FILE, or a key in AWS KMS by its ARN in SECRETS_KEY_KMS, instead.
# DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/postgres
# LEDGER_FILE=
# SECRETS_KEY=cmVwbGFjZS13aXRoLW9wZW5zc2wtcmFuZC1iYXNlNjQ=
