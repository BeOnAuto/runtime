{
  "name": "@on.auto/server",
  "version": "0.0.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "exports": {
    "./openapi-document": "./src/testing/openapi/served-document-text.ts"
  },
  "scripts": {
    "dev": "node dev.ts",
    "auto-runtime": "node auto-runtime.ts",
    "start": "node src/main.ts",
    "config-schema": "node config-schema.ts",
    "measure": "node measure.ts",
    "container:build": "docker build --file Dockerfile --tag onauto/runtime:local ../..",
    "container:run": "docker run --rm --publish 5555:5555 onauto/runtime:local",
    "npm:pack": "node npm/pack.ts",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:shard": "vitest run --shard=$VITEST_SHARD --coverage --coverage.reporter=none --coverage.thresholds.100=false --reporter=default --reporter=blob",
    "test:merge": "vitest run --merge-reports --coverage"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.137",
    "@effect/opentelemetry": "4.0.0",
    "@event-driven-io/emmett": "0.43.0-beta.50",
    "@hono/otel": "1.2.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@on.auto/api": "workspace:*",
    "@on.auto/computation": "workspace:*",
    "@on.auto/config": "workspace:*",
    "@on.auto/connections": "workspace:*",
    "@on.auto/coordination": "workspace:*",
    "@on.auto/definitions": "workspace:*",
    "@on.auto/identity": "workspace:*",
    "@on.auto/interaction": "workspace:*",
    "@on.auto/ledger": "workspace:*",
    "@on.auto/object-storage": "workspace:*",
    "@on.auto/operations": "workspace:*",
    "@on.auto/outbound": "workspace:*",
    "@on.auto/playbooks": "workspace:*",
    "@on.auto/prediction": "workspace:*",
    "@on.auto/providers": "workspace:*",
    "@on.auto/reasoning": "workspace:*",
    "@on.auto/recall": "workspace:*",
    "@on.auto/tool-servers": "workspace:*",
    "@on.auto/workflow-engine": "workspace:*",
    "@on.auto/workflow-host": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/instrumentation": "0.220.0",
    "@opentelemetry/instrumentation-runtime-node": "0.33.0",
    "@opentelemetry/instrumentation-undici": "0.30.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "effect": "catalog:",
    "hono": "catalog:",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
