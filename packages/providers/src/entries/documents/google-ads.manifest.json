        "hotelPropertyAssetSet",
        "travelCampaignSettings",
        "demandGenCampaignSettings",
        "localCampaignSetting",
        "listingType",
        "commission",
        "percentCpc",
        "targetCpv",
        "manualCpv",
        "fixedCpm",
        "excludedParentAssetSetTypes",
        "excludedParentAssetFieldTypes",
        "realTimeBiddingSetting"
      ],
      "because": "the settings of video, Shopping, Performance Max, app, hotel, travel, local, local services and Demand Gen campaigns and their hotel property asset set, the AI Max and text guidelines settings of Search, Shopping and Performance Max, the brand guidelines, asset automation, unbranded pharma ad, third-party integration partner, listing type, excluded parent asset and real-time bidding settings, and the commission, percent CPC, CPV and fixed CPM bidding strategies"
    },
