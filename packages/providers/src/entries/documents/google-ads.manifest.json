      },
      "leaves_out": [
        "demandGenAdGroupSettings",
        "videoAdGroupSettings",
        "verticalAdsFormatSetting",
        "aiMaxAdGroupSetting",
        "excludedParentAssetSetTypes",
        "excludedParentAssetFieldTypes",
        "targetCpvMicros",
        "cpvBidMicros",
        "fixedCpmMicros",
        "percentCpcBidMicros"
      ],
      "because": "the settings of Demand Gen and video ad groups, the AI Max and vertical ads format settings of Search ad groups, the excluded parent asset settings, and the target CPV, CPV, fixed CPM and percent CPC bids"
    },
    {
      "schema": "GoogleAdsGoogleadsV26Resources__AdGroupCriterion",
      "writable_in": {
        "GoogleAdsGoogleadsV26Services__AdGroupCriterionOperation": ["create", "update"]
      },
      "leaves_out": [
        "listingGroup",
        "verticalAdsItemGroupRuleList",
        "retailFilterBundle",
        "videoLineup",
        "youtubeVideo",
        "youtubeChannel",
        "mobileApplication",
        "mobileAppCategory",
        "appPaymentModel",
