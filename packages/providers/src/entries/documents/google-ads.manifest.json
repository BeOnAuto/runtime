    },
    {
      "schema": "GoogleAdsGoogleadsV26Resources__CampaignBudget",
      "writable_in": {
        "GoogleAdsGoogleadsV26Services__CampaignBudgetOperation": ["create", "update"]
      },
      "leaves_out": []
    },
    {
      "schema": "GoogleAdsGoogleadsV26Services__MutateOperation",
      "keeps": ["campaignBudgetOperation", "campaignOperation", "adGroupOperation", "adGroupCriterionOperation"],
      "holds": "the operations on campaign budgets, campaigns, ad groups and ad group criteria"
    }
  ]
